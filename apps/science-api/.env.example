# Orígenes permitidos para solicitudes CORS.
# Separar varios orígenes mediante comas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ruta absoluta al archivo FITS científico de M101.
# Configurar cuando el equipo científico proporcione el archivo.
M101_FITS_PATH=

# Optional ML artifacts. Export these variables before starting uvicorn, or use
# --env-file explicitly. No training runs at startup; missing artifacts return 503.
ETER_ML_PYTHON=
ETER_ML_WEIGHTS=
ETER_ML_SAMPLE=
ETER_BARNARD_ARTIFACTS_DIR=

# Additional OFFLINE FITS folders (os.pathsep: ':' on macOS/Linux, ';' on Windows).
# Defaults include ROI cache and morley_unified/outputs/data/candidates_05.
MORLEY_FITS_ROOTS=

# Optional server-owned JSON manifest of already prepared real ML triplets.
# This does not train models or generate difference images; see docs/mvp-workflow.md.
MORLEY_ML_TRIPLETS=
